{
  "name": "desktop",
  "productName": "Sharkord",
  "version": "0.0.26",
  "description": "Sharkord desktop shell",
  "author": "Sharkord",
  "type": "module",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env SHARKORD_ENV=development electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux -c electron-builder.linux.yml",
    "dist:linux:appimage": "electron-builder --linux -c electron-builder.linux-appimage.yml"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "electron-store": "^11.0.2",
    "events": "^3.3.0",
    "uiohook-napi": "^1.5.5"
  }
}
